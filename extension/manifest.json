{
  "manifest_version": 3,
  "name": "Quiet Feed · TypeSafe For LinkedIn",
  "description": "A calmer LinkedIn feed: hide suggested and old posts and posts liked by others, mute words, and optionally AI-style replies. Reveal anything with one click.",
  "version": "0.7.4",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:43127/*", "https://api.typesafe.ai/*", "https://www.linkedin.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Quiet Feed" },
  "content_scripts": [{ "matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:43127 https://api.typesafe.ai" }
}
